# Copy to phy-launch.env and edit values for your account/site.
# This file is sourced by phy-launch.sh automatically.

# Cluster identity
CLUSTER_USER=<your_cluster_username>
LOGIN_NODE=login1.int.janelia.org

# Remote python env (server runs here)
REMOTE_CONDA_ENV=phy
REMOTE_PYTHON=/groups/scicompsoft/home/<your_cluster_username>/miniconda3/envs/phy/bin/python
REMOTE_REPO_DIR=$HOME/phy-fastplotlib

# Local python env (GUI client runs here)
# If empty, launcher auto-detects python/python3 from PATH.
CLIENT_PYTHON=

# Optional default dataset root used by interactive/probe-shank modes
# OUTPUT_DIR=/groups/voigts/voigtslab/neuropixels_2025/.../output/
